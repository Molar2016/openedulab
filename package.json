{
  "name": "openedulab",
  "private": true,
  "version": "0.1.0-m1",
  "description": "OpenEduLab — interactive teaching experiments for authenticated classrooms. Pre-auth prototype: login is required by requirements v2.1 but is NOT implemented yet (B1 skeleton only; no route serves protected data).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p apps/api/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config apps/api/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "validate:content": "node scripts/validate-content.mjs",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "prestart:api": "npm run build:api",
    "start:api": "node apps/api/dist/index.js",
    "smoke:api": "node apps/api/scripts/smoke.mjs",
    "check": "npm run typecheck && npm run typecheck:api && npm run lint && npm run test && npm run test:api && npm run validate:content && npm run build && npm run build:api"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
