# OpenEduLab API — required server configuration.
#
# There is no .env loader yet: export these variables (or set them in your shell /
# service unit) before `npm run start:api`. Missing required values make the process
# exit 1 with a list of problems; nothing listens with an incomplete configuration.
# Unknown OEL_* variables are rejected so a typo cannot silently disable a setting.

# development | test | production
OEL_ENV=development

# Bind address and port. No default for the port on purpose.
OEL_HOST=127.0.0.1
OEL_PORT=3210

# Public origin used for same-origin checks: CSRF `Origin` allow-list and the session
# cookie policy. Origin only: no path, query, fragment or credentials. Anything served
# over HTTPS must run with OEL_ENV=production (Secure + __Host- cookie).
OEL_PUBLIC_ORIGIN=http://127.0.0.1:3210

# SQLite file for local development. Parent directories are created on startup.
# ':memory:' is allowed only outside production.
OEL_DATABASE_PATH=apps/api/data/openedulab.sqlite

# Built SPA output; must contain index.html (run `npm run build` first).
OEL_STATIC_DIR=dist

# Numbered, checksummed migrations; applied in order at startup.
OEL_MIGRATIONS_DIR=apps/api/migrations

# Root of the content tree. The server indexes every `<folder>/manifest.json` at startup
# and refuses to start if the index is inconsistent (duplicate id/slug, bad semver, missing
# locale keys). The catalog and experiment endpoints are built from this index only.
OEL_CONTENT_DIR=experiments

# fatal | error | warn | info | debug | trace | silent (default: info)
OEL_LOG_LEVEL=info
